# Server Configuration
PORT=3000

# API Key — used in X-API-KEY header for all protected routes
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=change-this-to-a-random-string

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=moodle_ai
DB_USER=ai_user
DB_PASSWORD=change-this

# Ollama (local AI server)
OLLAMA_URL=http://localhost:11434

# Google Gemini API (fallback AI, free tier: 250 req/day)
# Get at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key-here

# Google Sheets API (homework export)
# Path to service account JSON key file
GOOGLE_SERVICE_ACCOUNT_PATH=./config/google-sheets-key.json
# ID from spreadsheet URL: docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_TEMPLATE_ID=your-sheet-id-here

# TinyMCE API Key (for web panel rich text editor)
# Get at: https://www.tiny.cloud/auth/signup/
TINYMCE_API_KEY=your-tinymce-key-here

# Node environment
NODE_ENV=development
